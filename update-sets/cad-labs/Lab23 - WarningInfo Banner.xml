<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_script_client"&gt;&lt;sys_script_client action="INSERT_OR_UPDATE"&gt;&lt;active&gt;true&lt;/active&gt;&lt;applies_extended&gt;false&lt;/applies_extended&gt;&lt;condition/&gt;&lt;description&gt;Reads scratchpad values loaded by the 'Update scratch pad on REG notification' business rule. Displays a message advising when a SOCI regualtory notificaiton task activity needs attention.&lt;/description&gt;&lt;field/&gt;&lt;global&gt;true&lt;/global&gt;&lt;isolate_script&gt;true&lt;/isolate_script&gt;&lt;messages/&gt;&lt;name&gt;SOCI info/warn banner&lt;/name&gt;&lt;order/&gt;&lt;script&gt;&lt;![CDATA[function onLoad() {
    //if SOCI task is not required, do not display any message
    if (!g_scratchpad.soci_notification_required) {
        return;
    }

    //if SOCI task is required but does not exist, tell the user
    if (!g_scratchpad.soci_task_exists) {
        g_form.addInfoMessage('SOCI notification may be required - use the Create SOCI Notification button');
    }

    //if SOCI task is required but there is already a notification task, let the user know
    if (g_scratchpad.soci_task_exists) {
        if (g_scratchpad.soci_task_state === '-5' || g_scratchpad.soci_task_state === '1' || g_scratchpad.soci_task_state === '2') {
            g_form.addInfoMessage('SOCI notification task in is progress');
        }

        if (g_scratchpad.soci_task_state === '3') {
            g_form.addInfoMessage('SOCI notification has been completed');
        }

        if (g_scratchpad.soci_task_state === '4') {
            g_form.addModerateMessage('The previous SOCI notification task was not completed - review if still required');
        }

        if (g_scratchpad.soci_task_state === '8') {
            g_form.addModerateMessage('The previous SOCI notification was closed as no longer required - review if still required');
        }
    }
}]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script_client&lt;/sys_class_name&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-08-09 06:03:34&lt;/sys_created_on&gt;&lt;sys_domain&gt;global&lt;/sys_domain&gt;&lt;sys_domain_path&gt;/&lt;/sys_domain_path&gt;&lt;sys_id&gt;4a7fbd1e832e4b1044779cb6feaad3bb&lt;/sys_id&gt;&lt;sys_mod_count&gt;3&lt;/sys_mod_count&gt;&lt;sys_name&gt;SOCI info/warn banner&lt;/sys_name&gt;&lt;sys_overrides/&gt;&lt;sys_package display_value="Cyber Incident Management" source="x_1776078_cyber_0"&gt;9c0eda15c31d03102d84f44ed4013148&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Cyber Incident Management"&gt;9c0eda15c31d03102d84f44ed4013148&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_client_4a7fbd1e832e4b1044779cb6feaad3bb&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-08-09 06:07:59&lt;/sys_updated_on&gt;&lt;table&gt;x_1776078_cyber_0_cyber_incident&lt;/table&gt;&lt;type&gt;onLoad&lt;/type&gt;&lt;ui_type&gt;0&lt;/ui_type&gt;&lt;view/&gt;&lt;/sys_script_client&gt;&lt;/record_update&gt;</payload>
